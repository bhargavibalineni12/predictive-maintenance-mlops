    "    USER user\n",
    "    ENV HOME=/home/user \\\n",
    "        PATH=/home/user/.local/bin:$PATH\n",
    "\n",
    "    WORKDIR $HOME/app\n",
    "\n",
    "    COPY --chown=user . $HOME/app\n",
    "\n",
